{
  "dependencies": {
    "dompurify": "^3.4.17",
    "firebase": "^13.1.0",
    "html2pdf.js": "^0.14.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "autoprefixer": "^10.6.1",
    "linkedom": "^0.18.14",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5"
  },
  "name": "control-tcc-studio",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "description": "Aplicación modular de hábitos y organización personal",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test && npm run build",
    "format": "prettier --write src functions/*.js tests scripts *.js *.json docs/*.md README.md"
  }
}
